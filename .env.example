# RuleShift backend configuration example.
# Copy to .env and fill in real values. Never commit the real .env file
# (it is already listed in .gitignore).

# Database connection. Default for local development:
DATABASE_URL=sqlite:///./ruleshift.db

# Admin account (required for POST /auth/login):
RULESHIFT_ADMIN_EMAIL=admin@example.edu
RULESHIFT_ADMIN_PASSWORD=change-me

# JWT signing secret (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
RULESHIFT_JWT_SECRET=change-me-to-a-long-random-string

# Optional: admin token lifetime in minutes (default: 60):
# RULESHIFT_JWT_EXPIRE_MINUTES=60
# Backend-only Gemini API key shared by generation and embeddings.
RULESHIFT_GEMINI_API_KEY=change-me

# LiteLLM generation provider. Model names use LiteLLM's provider/model format.
RULESHIFT_LITELLM_MODEL=gemini/gemini-3.5-flash-lite

# Derived vector index and backend-only external embedding provider.
RULESHIFT_CHROMA_PATH=./chroma_db
RULESHIFT_EMBEDDING_PROVIDER=google
RULESHIFT_EMBEDDING_MODEL=gemini-embedding-001

# Optional upload limit in bytes (default 10 MiB).
# RULESHIFT_MAX_UPLOAD_BYTES=10485760
